# No network by default: npm run smoke -- --help
# Explicit billable opt-in: npm run smoke -- --live --run-id stable-run-001
# Reuse the same run ID/account; failures can still be billed. Never auto-retry.
AI_SMOKE_API_URL=http://127.0.0.1:3001
AI_SMOKE_PROJECT_ID=your-firebase-project-id
AI_SMOKE_FIREBASE_API_KEY=your-public-firebase-web-api-key
AI_SMOKE_EMAIL=dedicated-test-account@example.com
AI_SMOKE_PASSWORD=
# For --emulator use demo-kesefly, demo-key and an existing local Auth account;
# Auth localhost:9099 and server explicit demo auth/live provider flags required.
# OPENAI_API_KEY belongs only in server/.env, never in this smoke client.
