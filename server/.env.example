# Run commands from server/: npm run dev (or npm run build && npm start).
FIREBASE_PROJECT_ID=your-firebase-project-id
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/ai.sqlite
STATIC_DIR=../dist
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:5000
# OpenAI is independently billed. Empty key safely disables new extractions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Explicit local-only demo authentication; never enable for production.
AI_ALLOW_EMULATOR_AUTH=false
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
OPENAI_ALLOW_EMULATOR_LIVE=false
