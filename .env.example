# Copy to .env; no Firebase configuration is required for local manual transactions.
# Firebase Console > Project settings > Your apps > Web app SDK configuration.
# These public client identifiers are embedded in the app; Firestore rules protect data.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Optional custom HTTPS .litertlm artifact; set URL + verified SHA-256 together.
# Leave blank to use the pinned official Gemma 4 E2B artifact configured in src/core/ai/.
# Never put Hugging Face tokens, admin credentials, or signed private URLs here.
EXPO_PUBLIC_MODEL_URL=
EXPO_PUBLIC_MODEL_SHA256=
