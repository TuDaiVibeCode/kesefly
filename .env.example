# Copy to .env. Manual offline transactions need no Firebase or OpenAI key.
# Firebase Console > Project settings > Your apps > Web app SDK configuration.
# These public identifiers ship in the bundle; Firestore rules and Auth protect data.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Standalone Express API origin; no Cloud Functions or Blaze required.
EXPO_PUBLIC_AI_API_URL=http://localhost:3001
# For trusted private LAN demo HTTP only; use HTTPS for public deployments.
EXPO_PUBLIC_ALLOW_INSECURE_AI_HTTP=false

# OpenAI key belongs ONLY in server/.env or the Express host's secret environment.
# Never set EXPO_PUBLIC_OPENAI_API_KEY or embed credentials in this app.

# Optional Firebase Auth/Firestore emulators (not Express API).
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
